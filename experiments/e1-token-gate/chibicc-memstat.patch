+extern int memstat_kind;
+extern int memstat_phase;
+#define MS_CALLOC(kind, n, sz) \
+  (memstat_kind = (kind), memstat_tmp = calloc(n, sz), memstat_kind = MS_OTHER, memstat_tmp)
+extern void *memstat_tmp;
+struct Obj;
+void memstat_walk(struct Obj *prog);
+void memstat_report(size_t outbuf_len, void *outbuf);
